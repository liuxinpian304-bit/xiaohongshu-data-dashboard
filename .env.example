API_PORT=3001
# Replace every angle-bracket placeholder. URL-encode passwords in connection URLs.
POSTGRES_PASSWORD=<strong-migration-owner-password>
XHS_RUNTIME_PASSWORD=<different-strong-runtime-password>
DATABASE_MIGRATION_URL=postgresql://postgres:<url-encoded-migration-owner-password>@localhost:55432/xhs_dashboard
DATABASE_URL=postgresql://xhs_runtime:<url-encoded-runtime-password>@localhost:55432/xhs_dashboard

# Local-only real Xiaohongshu QR browser session. Generate a random token with at least 32 bytes.
LOCAL_XHS_COLLECTOR_ENABLED=false
LOCAL_XHS_COLLECTOR_HOST=127.0.0.1
LOCAL_XHS_COLLECTOR_PORT=43127
LOCAL_XHS_COLLECTOR_TOKEN=<random-local-token-at-least-32-bytes>
LOCAL_XHS_COLLECTOR_URL=http://127.0.0.1:43127
LOCAL_XHS_BROWSER_CHANNEL=chrome
