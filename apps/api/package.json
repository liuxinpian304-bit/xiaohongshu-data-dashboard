    "@xhs/database": "workspace:*",
    "@xhs/connector": "workspace:*",
    "@xhs/domain": "workspace:*",
    "argon2": "^0.44.0",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/supertest": "^6.0.3",
    "@nestjs/testing": "^11.1.6",
    "supertest": "^7.1.4",
