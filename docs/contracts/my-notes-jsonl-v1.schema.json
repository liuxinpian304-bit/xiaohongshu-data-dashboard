{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/liuxinpian304-bit/xiaohongshu-data-dashboard/blob/main/docs/contracts/my-notes-jsonl-v1.schema.json",
  "title": "my_notes.jsonl v1 line",
  "type": "object",
  "additionalProperties": false,
  "required": ["note", "metrics", "views_available"],
  "properties": {
    "note": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platformId", "accountId", "title", "publishedAt", "source"],
      "properties": {
        "platformId": { "type": "string", "minLength": 1, "maxLength": 200 },
        "accountId": { "type": "string", "maxLength": 200 },
        "title": { "type": "string", "maxLength": 1000 },
        "publishedAt": { "type": "string", "format": "date-time" },
        "source": { "const": "self-scrape" }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["noteId", "capturedAt", "views", "likes", "comments", "source"],
      "properties": {
        "noteId": { "type": "string", "minLength": 1, "maxLength": 200 },
        "capturedAt": { "type": "string", "format": "date-time" },
        "views": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "likes": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "comments": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "source": { "const": "self-scrape" }
      }
    },
    "extra": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "collected": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "shares": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
      }
    },
    "views_available": { "type": "boolean" }
  }
}
