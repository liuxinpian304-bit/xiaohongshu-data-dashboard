generator client {
  provider = "prisma-client"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
}

enum SyncJobStatus {
  pending
  running
  succeeded
  failed
}

enum MetricAvailability {
  zero
  not_synced
  awaiting_authorization
  not_provided
  available
}

enum MetricAggregation {
  cumulative_delta
  sum_interval
  period_end
  deduplicated_period
}

model Account {
  id                      String                    @id @default(uuid()) @db.Uuid
  connectorType           String
  platformId              String
  displayName             String?
  revocationState         String                    @default("none")
  revocationRetainData    Boolean?
  revocationRequestedAt   DateTime?                 @db.Timestamptz(3)
  revocationFailure       String?
  revocationOperationId   String?                   @db.Uuid
  createdAt               DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime                  @updatedAt @db.Timestamptz(3)
  credentials             Credential[]
  capabilities            ConnectorCapability[]
  notes                   Note[]
  syncJobs                SyncJob[]
  reports                 Report[]
  notifications           Notification[]
  commentSyncCompleteness CommentSyncCompleteness[]
  backfillEvents          BackfillEvent[]
  pushSubscriptions       PushSubscription[]

  @@unique([connectorType, platformId])
  @@index([id, revocationOperationId, revocationState])
}

model Credential {
  id        String    @id @default(uuid()) @db.Uuid
  accountId String    @db.Uuid
  kind      String
  secret    String
  expiresAt DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  account   Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, kind])
}

model ConnectorCapability {
  id         String   @id @default(uuid()) @db.Uuid
  accountId  String   @db.Uuid
  capability String
  enabled    Boolean  @default(false)
  checkedAt  DateTime @default(now()) @db.Timestamptz(3)
  account    Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, capability])
}

model Note {
  id            String           @id @default(uuid()) @db.Uuid
  accountId     String           @db.Uuid
  connectorType String
  platformId    String
  title         String
  publishedAt   DateTime         @db.Timestamptz(3)
  firstSeenAt   DateTime         @default(now()) @db.Timestamptz(3)
  lastSeenAt    DateTime         @default(now()) @db.Timestamptz(3)
  createdAt     DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime         @updatedAt @db.Timestamptz(3)
  account       Account          @relation(fields: [accountId], references: [id], onDelete: Restrict)
  snapshots     MetricSnapshot[]
  comments      Comment[]

  @@unique([connectorType, platformId])
  @@index([accountId, publishedAt])
}

model MetricDefinition {
  id            String           @id @default(uuid()) @db.Uuid
  key           String
  displayName   String
  unit          String
  aggregation   MetricAggregation @default(cumulative_delta)
  source        String            @default("legacy")
  version       String            @default("legacy-v1")
  effectiveFrom DateTime          @default(now()) @db.Timestamptz(3)
  effectiveTo   DateTime?         @db.Timestamptz(3)
  createdAt     DateTime         @default(now()) @db.Timestamptz(3)
  snapshots     MetricSnapshot[]
  reportMetrics ReportMetric[]

  @@unique([key, source, version])
}

model MetricSnapshot {
  id                 String             @id @default(uuid()) @db.Uuid
  noteId             String             @db.Uuid
  metricDefinitionId String             @db.Uuid
  availability       MetricAvailability
  value              Decimal?           @db.Decimal(20, 4)
  capturedAt         DateTime           @db.Timestamptz(3)
  source             String
  aggregation        MetricAggregation @default(cumulative_delta)
  aggregationVersion String            @default("legacy-v1")
  windowStart        DateTime?          @db.Timestamptz(3)
  windowEnd          DateTime?          @db.Timestamptz(3)
  authoritativePeriod Boolean           @default(false)
  revision           Int                @default(1)
  supersedesId       String?            @unique @db.Uuid
  supersededAt       DateTime?           @db.Timestamptz(3)
  correctedAt        DateTime?           @db.Timestamptz(3)
  correctionReason   String?
  sourceRunId        String?
  note               Note               @relation(fields: [noteId], references: [id], onDelete: Restrict)
  metricDefinition   MetricDefinition   @relation(fields: [metricDefinitionId], references: [id], onDelete: Restrict)
  supersedes         MetricSnapshot?    @relation("MetricSnapshotRevision", fields: [supersedesId], references: [id], onDelete: Restrict)
  supersededBy       MetricSnapshot?    @relation("MetricSnapshotRevision")

  @@unique([noteId, metricDefinitionId, capturedAt, revision])
  @@index([capturedAt])
}

model Comment {
  id               String   @id @default(uuid()) @db.Uuid
  noteId           String?  @db.Uuid
  connectorType    String
  platformId       String
  parentPlatformId String?
  content          String
  publishedAt      DateTime @db.Timestamptz(3)
  firstSeenAt      DateTime @default(now()) @db.Timestamptz(3)
  lastSeenAt       DateTime @default(now()) @db.Timestamptz(3)
  likeCount        Int      @default(0)
  source           String
  note             Note?    @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@unique([connectorType, platformId])
  @@index([noteId, publishedAt])
  @@index([connectorType, parentPlatformId])
}

model SyncJob {
  id                 String           @id @default(uuid()) @db.Uuid
  externalJobId      String?          @unique
  accountId          String           @db.Uuid
  status             SyncJobStatus    @default(pending)
  currentStage       String           @default("authorize")
  verificationStatus String           @default("verified")
  startedAt          DateTime?        @db.Timestamptz(3)
  completedAt        DateTime?        @db.Timestamptz(3)
  error              String?
  payload            Json?
  createdAt          DateTime         @default(now()) @db.Timestamptz(3)
  account            Account          @relation(fields: [accountId], references: [id], onDelete: Cascade)
  steps              SyncStep[]
  checkpoints        SyncCheckpoint[]

  @@index([accountId, createdAt])
}

model SyncCheckpoint {
  id        String   @id @default(uuid()) @db.Uuid
  syncJobId String   @db.Uuid
  stage     String
  entityKey String
  cursor    String?
  completed Boolean  @default(false)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  syncJob   SyncJob  @relation(fields: [syncJobId], references: [id], onDelete: Cascade)

  @@unique([syncJobId, stage, entityKey])
}

model CommentSyncCompleteness {
  id             String   @id @default(uuid()) @db.Uuid
  connectorType  String
  accountId      String   @db.Uuid
  notePlatformId String
  status         String
  cursor         String?
  error          String?
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)
  account        Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([connectorType, accountId, notePlatformId])
}

model SyncStep {
  id          String        @id @default(uuid()) @db.Uuid
  syncJobId   String        @db.Uuid
  name        String
  status      SyncJobStatus @default(pending)
  startedAt   DateTime?     @db.Timestamptz(3)
  completedAt DateTime?     @db.Timestamptz(3)
  error       String?
  syncJob     SyncJob       @relation(fields: [syncJobId], references: [id], onDelete: Cascade)

  @@unique([syncJobId, name])
}

model Report {
  id               String         @id @default(uuid()) @db.Uuid
  accountId        String         @db.Uuid
  reportType       String
  periodStart      DateTime       @db.Timestamptz(3)
  periodEnd        DateTime       @db.Timestamptz(3)
  version          Int            @default(1)
  status           String         @default("complete")
  missingDates     String[]       @default([])
  missingFields    Json           @default("[]")
  backfillId       String?
  rebuildJobId     String?
  previousReportId String?        @db.Uuid
  rebuildReason    String?
  generatedAt      DateTime       @default(now()) @db.Timestamptz(3)
  evidenceRefs     Json           @default("[]")
  provenanceStatus String         @default("complete")
  account          Account        @relation(fields: [accountId], references: [id], onDelete: Restrict)
  metrics          ReportMetric[]

  @@unique([accountId, reportType, periodStart, periodEnd, version])
  @@index([accountId, reportType, periodStart, periodEnd])
  @@index([backfillId])
}

model ReportMetric {
  id                 String             @id @default(uuid()) @db.Uuid
  reportId           String             @db.Uuid
  metricDefinitionId String             @db.Uuid
  availability       MetricAvailability
  value              Decimal?           @db.Decimal(20, 4)
  report             Report             @relation(fields: [reportId], references: [id], onDelete: Cascade)
  metricDefinition   MetricDefinition   @relation(fields: [metricDefinitionId], references: [id], onDelete: Restrict)

  @@unique([reportId, metricDefinitionId])
}

model BackfillEvent {
  id            String   @id
  accountId     String   @db.Uuid
  noteId        String   @db.Uuid
  capturedDates String[]
  reason        String   @default("metric_snapshot_saved")
  dispatchStatus String  @default("pending")
  attempts      Int      @default(0)
  lastError     String?
  dispatchedAt  DateTime? @db.Timestamptz(3)
  claimedAt     DateTime? @db.Timestamptz(3)
  claimToken    String?
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  account       Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, createdAt])
  @@index([dispatchStatus, createdAt])
}

model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  eventId   String    @unique
  accountId String    @db.Uuid
  type      String
  title     String
  body      String
  link      String
  readAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  account   Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, createdAt])
}

model PushSubscription {
  id        String   @id @default(uuid()) @db.Uuid
  accountId String   @db.Uuid
  endpoint  String
  p256dh    String
  auth      String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, endpoint])
  @@index([accountId])
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actor      String
  action     String
  entityType String
  entityId   String
  details    Json?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@index([entityType, entityId])
  @@index([createdAt])
}

model AdminSession {
  id         String   @id @default(uuid()) @db.Uuid
  tokenHash  String   @unique
  csrfHash   String
  expiresAt  DateTime @db.Timestamptz(3)
  revokedAt  DateTime? @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@index([expiresAt])
}

model LoginAttempt {
  id          String   @id @default(uuid()) @db.Uuid
  fingerprint String
  attemptedAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([fingerprint, attemptedAt])
}
